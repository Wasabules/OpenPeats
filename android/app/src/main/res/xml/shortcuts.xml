            android:action="com.openpeats.action.MODE_TRANSPARENCY"
            android:targetClass="com.openpeats.ShortcutActivity"
            android:targetPackage="com.openpeats" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_off"
        android:shortcutId="off"
        android:shortcutShortLabel="@string/shortcut_off">
        <intent
            android:action="com.openpeats.action.MODE_OFF"
            android:targetClass="com.openpeats.ShortcutActivity"
            android:targetPackage="com.openpeats" />
