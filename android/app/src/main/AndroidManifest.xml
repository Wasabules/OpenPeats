<?xml version="1.0" encoding="utf-8"?>
<!-- Internal storage only: on an adopted SD card, where a phone may otherwise
     install it, Android lists none of the widgets and sends no boot event. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <!-- Android 12+: runtime Bluetooth permission. The app only talks to
         earbuds that are already paired and never scans, so CONNECT is all it
         asks for. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 and earlier. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- The service keeping the link up with no screen open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bringing a kept link back after a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Automatic detection, optional: see CompanionLink. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <application
        android:name=".OpenPeatsApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenPeats">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".service.EarbudsService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|shortService" />

        <service
            android:name=".service.AncTileService"
            android:exported="true"
            android:icon="@drawable/ic_mode_anc"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Only ever bound for an association, which the app offers from
             Android 13: earlier versions never load the class. -->
        <service
            android:name=".companion.EarbudsCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="tiramisu">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Exported because the Bluetooth stack, which sends the ACL events,
             is not the system user. All three actions are protected broadcasts:
             no other app can send them. -->
        <receiver
            android:name=".service.EarbudsEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".appwidget.ModesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_modes_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_modes_info" />
        </receiver>
        <receiver
            android:name=".appwidget.QuickSwitchWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_switch_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_switch_info" />
        </receiver>
        <receiver
            android:name=".appwidget.BatteryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_battery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>
        <receiver
            android:name=".appwidget.BatteryMiniWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_battery_mini_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_mini_info" />
        </receiver>
        <receiver
            android:name=".appwidget.DashboardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_dashboard_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dashboard_info" />
        </receiver>
        <receiver
            android:name=".appwidget.LevelsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_levels_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_levels_info" />
        </receiver>
        <receiver
            android:name=".appwidget.TogglesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_toggles_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_toggles_info" />
        </receiver>
    </application>
</manifest>
