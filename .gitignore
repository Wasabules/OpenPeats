# ---------------------------------------------------------------------------
# Reverse-engineering material — NEVER PUBLISH
#
# The official application's APK and everything derived from it (decompiled
# code, smali, resources) stay strictly local. This repository only holds code
# written independently from the observed specification.
#
# This rule is about the *manufacturer's* APK. The release workflow builds our
# own APK on the runner and uploads it straight to the GitHub release, so it
# never passes through git.
# ---------------------------------------------------------------------------
*.apk
jadx-out/
smali-out/
dexdir/
*.dex
*.jar
*.btsnoop
hci.btsnoop

# Exception: the Gradle wrapper is a legitimate project binary, without which
# ./gradlew does not work on a fresh clone.
!android/gradle/wrapper/gradle-wrapper.jar

# Build artefacts
build/bin/
probe/peats-probe
peatsaudio/frontend/dist/
peatsaudio/frontend/node_modules/
peatsaudio/frontend/wailsjs/
node_modules/

# Release staging, produced by .github/workflows/release.yml
dist/

# Misc
*.log
.DS_Store

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
android/keystore.jks

# Compiled binaries at the root
/peatsctl
/peatsctl.exe
