# ---------------------------------------------------------------------------
# Matériel de rétro-ingénierie — NE JAMAIS PUBLIER
#
# L'APK de l'application officielle et tout ce qui en dérive (code décompilé,
# smali, ressources) restent strictement locaux. Le dépôt ne contient que du
# code écrit indépendamment à partir de la spécification observée.
# ---------------------------------------------------------------------------
*.apk
jadx-out/
smali-out/
dexdir/
*.dex
*.jar
*.btsnoop
hci.btsnoop

# Exception : le wrapper Gradle est un binaire légitime du projet, sans lequel
# ./gradlew ne fonctionne pas sur un clone frais.
!android/gradle/wrapper/gradle-wrapper.jar

# Artefacts de compilation
build/bin/
probe/peats-probe
peatsaudio/frontend/dist/
peatsaudio/frontend/node_modules/
peatsaudio/frontend/wailsjs/
node_modules/

# Divers
*.log
.DS_Store

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
